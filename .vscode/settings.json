{
  // ---------------------------------------------------------------- Go

  // vscode-go picks its golangci-lint flags from the tool *name*, so v2 must
  // be selected as "golangci-lint-v2" or it calls the binary with v1 flags
  // that no longer exist.
  "go.lintTool": "golangci-lint-v2",
  // mise installs the binary as plain "golangci-lint"; point the expected
  // name at it rather than keeping a second copy around.
  "go.alternateTools": {
    "golangci-lint-v2": "golangci-lint"
  },
  // Absolute paths make v2 diagnostics land on the right lines in the editor.
  "go.lintFlags": ["--path-mode=abs", "--fast-only"],
  "go.lintOnSave": "package",

  "go.testFlags": ["-race"],
  "go.testTimeout": "60s",
  "go.coverOnSingleTest": true,
  "go.coverageDecorator": {
    "type": "gutter"
  },

  // mise owns tool versions. Let it, or the extension will fight the pins.
  "go.toolsManagement.autoUpdate": false,

  "gopls": {
    "formatting.gofumpt": true,
    "ui.diagnostic.staticcheck": true,
    "ui.completion.usePlaceholders": true,
    "ui.semanticTokens": true
  },

  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // ---------------------------------------------------------------- schemas

  "yaml.schemas": {
    "https://golangci-lint.run/jsonschema/golangci.v2.jsonschema.json": ".golangci.yml",
    "https://raw.githubusercontent.com/evilmartians/lefthook/master/schema.json": "lefthook.yml",
    "https://goreleaser.com/static/schema.json": ".goreleaser.yaml"
  },

  // ---------------------------------------------------------------- general

  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",

  "search.exclude": {
    "**/bin": true,
    "**/dist": true,
    "**/docs/zoekt": true,
    "**/node_modules": true
  },

  // docs/zoekt is generated by `just docs-fetch`. Editing it by hand is always
  // a mistake, so it is read-only here rather than merely discouraged.
  "files.readonlyInclude": {
    "docs/zoekt/**": true
  },

  "files.associations": {
    "justfile": "just",
    ".justfile": "just"
  }
}
